                    ultimaDataObj = dataLocal;
                    ultimaDataTexto = formatarDataExcel(valData);
                }
            }
        }
    });

    return {
        codigo: codigoPrincipal,
        descricao: descricaoItem,
        saldoAtual: obterValorOuPadrao(saldoAtual),
