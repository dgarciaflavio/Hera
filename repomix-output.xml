        if (p.length === 3) return new Date(p[2], p[1] - 1, p[0]).getTime();
        return new Date(9999, 11, 31).getTime();
    };

    // Ordenar Atas a Vencer (Urgência - Data mais próxima)
    const atasUrgentes = [...dadosAgregados.atasVigentesComSaldo]
