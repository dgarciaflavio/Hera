            const wsComSaldo = workbook.addWorksheet('Atas com Saldo');
            const wsSemSaldo = workbook.addWorksheet('Atas sem Saldo');
            const wsOutros = workbook.addWorksheet('Monitoramento Geral'); // NOVA GUIA
            
