function deduplicarAtasPorNumero(lista) {
    const mapa = new Map();

    for (const ata of lista || []) {
        const numero =
            String(
                ata?.numeroAtaRegistroPreco ||
                ata?.numeroAta ||
                ata?.numero_ata ||
