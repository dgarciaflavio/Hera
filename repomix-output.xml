                    rowGSup.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD5D8DC' } };
                    wsComSaldoSup.mergeCells(`A${rowGSup.number}:H${rowGSup.number}`);
                    
                    cat.comSaldo.forEach(d => {
