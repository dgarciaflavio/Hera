                if (deveIgnorarProcesso(processoAtaLoop, anoAtual)) return;

                if (numEmpenho && numEmpenho !== '0' && numEmpenho.toLowerCase() !== 'n/a') {
                    const matchAno = numEmpenho.match(/^(\d{4})/);
