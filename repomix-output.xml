            .replace(/### (.*?)\n/g, '<h3>$1</h3>')
            .replace(/## (.*?)\n/g, '<h2>$1</h2>')
            .replace(/# (.*?)\n/g, '<h1>$1</h1>');
        
        convertido = convertido.split('\n').map(linha => {
            if (linha.trim().startsWith('- ')) {
                return `<li>${linha.trim().substring(2)}</li>`;
            }
            return linha.trim() === '' ? '<br>' : `<p>${linha}</p>`;
        }).join('');

        convertido = convertido.replace(/(<li>.*<\/li>)/g, '<ul>$1</ul>').replace(/<\/ul><ul>/g, '');
