        if (!mod || mod === 'N/A') return false;
        const modUpper = String(mod).toUpperCase();
        if (modUpper === 'PREGÃO - REGISTRO DE PREÇOS' || modUpper === 'PREGÃO - REGISTRO DE PREÇOS - REPETIÇÃO') return false;
