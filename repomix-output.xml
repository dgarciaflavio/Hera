async function inicializarTabelaCartao() {
    return new Promise((resolve, reject) => {
        const db = getDbConnection();
        db.run(`CREATE TABLE IF NOT EXISTS compras_cartao (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            cod_item TEXT,
            valor_total REAL,
            fornecedor TEXT,
            ano TEXT,
            data_registro TEXT
        )`, (err) => {
            db.close();
            if (err) reject(err);
            else resolve();
        });
