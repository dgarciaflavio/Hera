                messages: [
                    { 
                        role: 'system', 
                        content: 'Você é um assistente executivo especialista em logística, contratos e gestão de estoque. Seu tom é analítico, sintético e voltado à resolução de problemas.' 
                    },
                    { 
                        role: 'user', 
                        content: prompt 
                    }
                ],
