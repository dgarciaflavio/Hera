                    rowG.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD5D8DC' } };
                    wsSemSaldo.mergeCells(`A${rowG.number}:H${rowG.number}`);
                    
                    cat.semSaldo.forEach(d => {
