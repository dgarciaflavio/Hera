                    alertasPorTelefone[donoRef.telefone].gruposNotes[notesItem].outros.push(dadosItemExcel);
                }
                itensProcessados++;
            };

            if (valorColA === 'FAR') {
                const donoFAR = regras.find(r => r.ref === 'FAR');
                if (donoFAR) alocarNoPlanejador(donoFAR);
                continue;
