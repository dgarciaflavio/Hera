        };
        
        const nomeMeses = ['jan.', 'fev.', 'mar.', 'abr.', 'mai.', 'jun.', 'jul.', 'ago.', 'set.', 'out.', 'nov.', 'dez.'];
        nomeMeses.forEach(mes => {
            if (!estatisticasMensais[mes]) estatisticasMensais[mes] = {};
        });

        for (const pregao of contratacoes) {
