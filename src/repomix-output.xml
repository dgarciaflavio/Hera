}

async function aguardarSaidaDaTelaDeLogin(page) {
    return await esperarComTentativas(async () => {
        const urlAtual = String(page.url() || '').toLowerCase();
        const foraDoLogin = !urlAtual.includes('/sip/login.php');

        if (foraDoLogin) {
            return true;
        }

        const totalFrames = page.frames().length;
        if (totalFrames > 1) {
            return true;
        }

        return null;
    }, {
        descricao: 'saída da tela de login do SEI',
        tentativas: 25,
        intervaloMs: 1000
    });
}

async function realizarLogin(page, metricas = null) {
    const etapa = metricas ? marcarInicioEtapa(metricas, 'login no SEI') : null;

    console.log('🔐 [SEI] Acessando tela de login...');
    await page.goto(URL_LOGIN_SEI, { waitUntil: 'domcontentloaded' });

    await page.waitForSelector('#txtUsuario', { timeout: 15000 });
    await page.fill('#txtUsuario', process.env.SEI_USER || '5286');

    console.log('🔑 [SEI] Preenchendo senha...');
    const campoSenhaVisivel = page.locator('input.masked:not([type="password"])');
    await campoSenhaVisivel.waitFor({ state: 'visible', timeout: 10000 });
    await campoSenhaVisivel.click();
    await esperar(300);
    await campoSenhaVisivel.pressSequentially(process.env.SEI_PASS || 'Gênesis01:01', { delay: 120 });

    console.log('🏢 [SEI] Selecionando órgão...');
    await page.selectOption('#selOrgao', ORGAO_INCA);

    console.log('➡️ [SEI] Entrando no sistema...');
    await page.click('#sbmAcessar');

    await page.waitForLoadState('domcontentloaded').catch(() => {});
    await esperar(TEMPO_ESPERA_LONGO);

    await tentarFecharBannerPosLogin(page).catch(() => {});
    await aguardarSaidaDaTelaDeLogin(page).catch(() => {});

    await page.waitForLoadState('domcontentloaded').catch(() => {});
    await aguardarFramesEstabilizarem(page, 20);
    await esperar(TEMPO_ESPERA_LONGO);

    logarFrames(page, 'Frames após login');

    if (metricas && etapa) {
        finalizarEtapa(metricas, etapa);
    }
}

async function pesquisarProcesso(numeroProcesso, page, metricas = null) {
    const etapa = metricas ? marcarInicioEtapa(metricas, `busca do processo ${numeroProcesso}`) : null;

    console.log(`🔎 [SEI] Procurando processo ${numeroProcesso}...`);

    const { frame: frameNavSuperior, elemento: campoPesquisa } = await localizarBarraPesquisa(page);

    await campoPesquisa.click();
    await frameNavSuperior.fill('input[name^="txtPesquisa"]', '');
    await frameNavSuperior.fill('input[name^="txtPesquisa"]', numeroProcesso);
    await esperar(500);
    await frameNavSuperior.press('input[name^="txtPesquisa"]', 'Enter');

    await page.waitForLoadState('domcontentloaded').catch(() => {});
    await aguardarFramesEstabilizarem(page, 20);
    await esperar(TEMPO_ESPERA_LONGO);

    if (metricas && etapa) {
        finalizarEtapa(metricas, etapa);
    }
}

async function acessarProcessoSEI(numeroProcesso, page, metricas = null) {
    await realizarLogin(page, metricas);
    await pesquisarProcesso(numeroProcesso, page, metricas);

    const etapa = metricas ? marcarInicioEtapa(metricas, 'localização e estabilização da árvore') : null;

    console.log('🌳 [SEI] Localizando frame da árvore...');
    const escopoFinalArvore = await encontrarFrameDaArvore(page);

    if (!escopoFinalArvore) {
        logarFrames(page, 'Frames quando falhou a localização da árvore');
        throw new Error('Não foi possível isolar o componente interno da árvore.');
    }

    await esperarArvoreEstabilizar(escopoFinalArvore, page);

    console.log('✅ [SEI] Árvore do processo localizada e estabilizada.');

    if (metricas && etapa) {
        finalizarEtapa(metricas, etapa);
    }

    return escopoFinalArvore;
}

async function expandirTodasPastas(escopoFinalArvore, page, metricas = null) {
    const etapa = metricas ? marcarInicioEtapa(metricas, 'expansão da árvore SEI') : null;

    const seletorExpandir = 'a[title^="Expandir"], img[src*="mais"], a[href*="infraArvoreExpandir"]';
    const seletorUniversal = 'a.infraArvoreNo, span.infraArvoreNo a, a[id^="ancora"]';

    console.log('🗂️ [SEI] Sincronizando árvore...');
    await escopoFinalArvore.waitForSelector(seletorUniversal, { timeout: 15000 }).catch(() => {});
    await esperarArvoreEstabilizar(escopoFinalArvore, page);

    let totalCliques = 0;
    let ciclosSemNovidade = 0;

    for (let ciclo = 0; ciclo < 25; ciclo++) {
        let nosFechados = [];
        try {
            nosFechados = await escopoFinalArvore.$$(seletorExpandir);
        } catch (erro) {
            nosFechados = [];
        }

        if (!nosFechados.length) {
            ciclosSemNovidade++;
            if (ciclosSemNovidade >= 2) {
                break;
            }
            await esperar(TEMPO_ESPERA_MEDIO);
            continue;
        }

        ciclosSemNovidade = 0;

        try {
            const no = nosFechados[0];
            if (no) {
                totalCliques++;
                console.log(`📂 [SEI] Expandindo nó ${totalCliques}...`);
                await no.click({ force: true }).catch(async () => {
                    try {
                        await no.evaluate(el => el.click());
                    } catch (erro) {}
                });

                await esperarArvoreEstabilizar(escopoFinalArvore, page, {
                    tentativas: 20,
                    intervaloMs: 400
                });

                await esperar(TEMPO_ESPERA_CURTO);
            }
        } catch (erro) {
            await esperar(TEMPO_ESPERA_CURTO);
        }
    }

    console.log(`✅ [SEI] Expansão da árvore concluída. Nós processados: ${totalCliques}`);
    await esperarArvoreEstabilizar(escopoFinalArvore, page);
    await esperar(TEMPO_ESPERA_MEDIO);

    if (metricas && etapa) {
        finalizarEtapa(metricas, etapa);
    }
}

function nomeDocumentoValido(texto, id) {
    const textoLimpo = String(texto || '').trim();
    const idLimpo = String(id || '');

    if (!textoLimpo) return false;
    if (textoLimpo === 'Aguarde...') return false;

    if (
        idLimpo.includes('ancVoltar') ||
        idLimpo.includes('ancIcones') ||
        idLimpo.includes('ancAnterior') ||
        idLimpo.includes('ancProximo') ||
        idLimpo.includes('ancAbrir') ||
        idLimpo.includes('ancFechar')
    ) {
        return false;
    }

    return true;
}

async function coletarLinksDocumentos(escopoFinalArvore) {
    const seletorUniversal = 'a.infraArvoreNo, span.infraArvoreNo a, a[id^="ancora"]';
    const linksDocumentos = await escopoFinalArvore.$$(seletorUniversal);
    const documentos = [];

    for (const link of linksDocumentos) {
        try {
            const id = await link.getAttribute('id') || '';
            const texto = await link.innerText() || '';
            const textoLimpo = texto.trim();

            if (nomeDocumentoValido(textoLimpo, id)) {
                documentos.push({
                    id,
                    nome: textoLimpo,
                    handle: link
                });
            }
        } catch (erro) {}
    }

    return documentos;
}

async function listarDocumentosSEI(numeroProcesso) {
    return await executarComTimeout(async () => {
        const metricas = iniciarMetricasSei(`listagem do processo ${numeroProcesso}`);
        console.log(`🚀 [SEI] Iniciando listagem de documentos do processo ${numeroProcesso}...`);

        const browser = await chromium.launch({
            headless: true,
            channel: 'msedge'
        });

        const context = await browser.newContext();
        const page = await context.newPage();

        try {
            const escopoFinalArvore = await acessarProcessoSEI(numeroProcesso, page, metricas);
            await expandirTodasPastas(escopoFinalArvore, page, metricas);

            const etapaColeta = marcarInicioEtapa(metricas, 'coleta dos documentos da árvore');
            const documentos = await coletarLinksDocumentos(escopoFinalArvore);
            const listaNomesDocumentos = [];
            const vistos = new Set();

            for (const doc of documentos) {
                if (!vistos.has(doc.nome)) {
                    vistos.add(doc.nome);
                    listaNomesDocumentos.push(doc.nome);
                }
            }

            finalizarEtapa(metricas, etapaColeta);
            console.log(`📋 [SEI] ${listaNomesDocumentos.length} documento(s) encontrado(s).`);

            finalizarMetricasSei(metricas);

            await browser.close();
            return listaNomesDocumentos;
        } catch (error) {
            console.error('❌ [SEI] Erro ao listar documentos:', error);
            await browser.close();
            throw error;
        }
    }, TIMEOUT_LISTAGEM_SEI_MS, `listagem SEI do processo ${numeroProcesso}`);
}

async function encontrarDocumentoNaArvore(escopoFinalArvore, nomeDocumentoAlvo) {
    const nomeAlvo = String(nomeDocumentoAlvo || '').trim();

    return await esperarComTentativas(async () => {
        const documentos = await coletarLinksDocumentos(escopoFinalArvore);

        for (const doc of documentos) {
            if (doc.nome === nomeAlvo) {
                return doc.handle;
            }
        }

        return null;
    }, {
        descricao: `documento "${nomeDocumentoAlvo}" na árvore`,
        tentativas: 12,
        intervaloMs: 500
    });
}

async function aguardarDocumentoAbrir(page, metricas = null) {
    const etapa = metricas ? marcarInicioEtapa(metricas, 'abertura e estabilização do documento') : null;

    await page.waitForLoadState('domcontentloaded').catch(() => {});
    await aguardarFramesEstabilizarem(page, 12);

    const frameConteudo = await encontrarFrameConteudoVisualizacao(page);
    if (!frameConteudo) {
        return null;
    }

    await esperarComTentativas(async () => {
        try {
            const texto = await frameConteudo.evaluate(() => {
                return (document.documentElement?.innerText || document.body?.innerText || '').trim();
            });

            if (texto && texto.length > 20) {
                return true;
            }
        } catch (erro) {}

        return false;
    }, {
        descricao: 'conteúdo do documento SEI carregar',
        tentativas: 15,
        intervaloMs: 500
    }).catch(() => null);

    await esperar(TEMPO_ESPERA_LONGO);

    if (metricas && etapa) {
        finalizarEtapa(metricas, etapa);
    }

    return frameConteudo;
}

async function localizarUrlImpressao(page) {
    for (const frame of page.frames()) {
        try {
            const btnImprimir = await frame.$('a[href*="documento_imprimir_web"]');
            if (btnImprimir) {
                const href = await frame.evaluate(el => el.href, btnImprimir);
                if (href) {
                    return href;
                }
            }
        } catch (erro) {}
    }

    const frameConteudo = await encontrarFrameConteudoVisualizacao(page);
    if (frameConteudo) {
        const url = frameConteudo.url();
        if (url) {
            return url;
        }
    }

    return null;
}

async function extrairDocumentoSEIPdf(numeroProcesso, nomeDocumentoAlvo) {
    return await executarComTimeout(async () => {
        const metricas = iniciarMetricasSei(`extração do documento "${nomeDocumentoAlvo}" do processo ${numeroProcesso}`);
        console.log(`📄 [SEI] Iniciando extração do documento "${nomeDocumentoAlvo}" do processo ${numeroProcesso}...`);

        const browser = await chromium.launch({
            headless: true,
            channel: 'msedge'
        });

        const context = await browser.newContext();
        const page = await context.newPage();

        try {
            const escopoFinalArvore = await acessarProcessoSEI(numeroProcesso, page, metricas);
            await expandirTodasPastas(escopoFinalArvore, page, metricas);

            const etapaLocalizacao = marcarInicioEtapa(metricas, `localização do documento "${nomeDocumentoAlvo}"`);
            console.log(`🎯 [SEI] Localizando documento alvo: "${nomeDocumentoAlvo}"...`);
            const elementoAlvoFresco = await encontrarDocumentoNaArvore(escopoFinalArvore, nomeDocumentoAlvo);
            if (!elementoAlvoFresco) {
                throw new Error(`O documento "${nomeDocumentoAlvo}" não foi localizado na árvore expandida.`);
            }
            finalizarEtapa(metricas, etapaLocalizacao);

            console.log('🖱️ [SEI] Abrindo documento...');
            await elementoAlvoFresco.click({ force: true }).catch(async () => {
                try {
                    await elementoAlvoFresco.evaluate(el => el.click());
                } catch (erro) {}
            });

            const frameConteudo = await aguardarDocumentoAbrir(page, metricas);

            if (!frameConteudo) {
                throw new Error('O frame do documento não carregou corretamente após a abertura.');
            }

            const etapaUrl = marcarInicioEtapa(metricas, 'localização da URL de impressão');
            console.log('🖨️ [SEI] Procurando URL de impressão/visualização...');
            const urlImpressao = await localizarUrlImpressao(page);
            if (!urlImpressao) {
                throw new Error('Não consegui localizar o link de impressão ou de visualização interna do documento.');
            }
            console.log('🌐 [SEI] URL de impressão/visualização localizada.');
            finalizarEtapa(metricas, etapaUrl);

            const etapaPdf = marcarInicioEtapa(metricas, 'geração do PDF');
            const pdfPage = await context.newPage();
            await pdfPage.goto(urlImpressao, { waitUntil: 'domcontentloaded' }).catch(() => {});
            await pdfPage.waitForLoadState('domcontentloaded').catch(() => {});
            await esperar(TEMPO_ESPERA_LONGO);

            console.log('📥 [SEI] Gerando PDF...');
            const caminhoPdf = path.join(os.tmpdir(), `SEI_${Date.now()}.pdf`);
            await pdfPage.pdf({
                path: caminhoPdf,
                format: 'A4',
                printBackground: true,
                margin: {
                    top: '15mm',
                    bottom: '15mm',
                    left: '15mm',
                    right: '15mm'
                }
            });
            finalizarEtapa(metricas, etapaPdf);

            console.log(`✅ [SEI] PDF gerado com sucesso em: ${caminhoPdf}`);
            finalizarMetricasSei(metricas);

            await browser.close();
            return caminhoPdf;
        } catch (error) {
            console.error('❌ [SEI] Erro ao extrair documento em PDF:', error);
            await browser.close();
            throw error;
        }
    }, TIMEOUT_EXTRACAO_SEI_MS, `extração SEI do documento "${nomeDocumentoAlvo}"`);
}

module.exports = { listarDocumentosSEI, extrairDocumentoSEIPdf };
