        dataUltimaEntrada: ultimaDataTexto,
        vencimentoAta,
        saldoAta,
        processoAta,
        modalidadeAta,
        solicitacaoNotesAta,
        solicitacaoAeAta,
        processosEmAndamento: Array.from(mapaProcessos.entries()).map(([k, v]) => `${k} (Qtd: ${v})`).join(', ') || 'Nenhum',
