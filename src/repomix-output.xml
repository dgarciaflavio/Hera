                    // Trata também a existência do PROCESSO DE ATA preenchido na linha como indicador de que existiu ata
                    if (procAtaLoop && procAtaLoop !== '0' && procAtaLoop.toUpperCase() !== 'N/A') {
                        teveAlgumaAtaCadastrada = true;
                    }
