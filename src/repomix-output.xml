            if (ignorarAvn && setAvn.has(item)) return;

            if (!itensAgrupados[item]) itensAgrupados[item] = [];
            itensAgrupados[item].push(linha);
        });

        for (const itemOriginal in itensAgrupados) {
            if (itemOriginal.toUpperCase().startsWith('A50')) continue;

