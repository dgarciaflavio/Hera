            const mod2 = detalhesAndamento.modalidade2;
            const sol = objAndamento.solicitacao !== 'N/A' ? objAndamento.solicitacao : detalhesAndamento.solicitacao2;
            
            if (mod2 !== 'N/A' && mod2 !== '') resposta += `${processo} - ${mod2}\n`;
            else resposta += `${processo}\n`;
            
