        for (const k in linha) { 
            const low = k.trim().toLowerCase();
            if (low === 'item' || low === 'codigo') codigoLinhaVal = linha[k]; 
        }
        return String(codigoLinhaVal || '').trim().toUpperCase() === codigoPrincipal;
