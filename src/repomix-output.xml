            if (ehModalidadeFechada && parseNumeroPTBR(saldoStr) <= 0) {
                ataValida = false;
            }

            const solicitacoesVinculadas = mapaSolicitacoesProcesso.get(processoAtaStr) || { solNotes: 'N/A', solAe: 'N/A' };
