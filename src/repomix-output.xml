const { chromium } = require('playwright');
const path = require('path');
const os = require('os');
require('dotenv').config();

const URL_LOGIN_SEI = 'https://sei.saude.gov.br/sip/login.php?sigla_orgao_sistema=MS&sigla_sistema=SEI&infra_url=L3NlaS8=';
const ORGAO_INCA = '66';

const TEMPO_ESPERA_CURTO = 500;
const TEMPO_ESPERA_MEDIO = 1000;
const TEMPO_ESPERA_LONGO = 2000;

const TIMEOUT_LISTAGEM_SEI_MS = Number(process.env.SEI_TIMEOUT_LISTAGEM_MS || 120000);
const TIMEOUT_EXTRACAO_SEI_MS = Number(process.env.SEI_TIMEOUT_EXTRACAO_MS || 180000);

async function esperar(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
}

function agoraMs() {
    return Date.now();
}

function formatarDuracao(ms) {
    if (!Number.isFinite(ms) || ms < 0) {
        return '0 ms';
    }

    if (ms < 1000) {
        return `${ms} ms`;
    }

    const segundos = (ms / 1000).toFixed(1);
    return `${segundos}s`;
}

function iniciarMetricasSei(contexto) {
    return {
        contexto,
        inicioTotal: agoraMs(),
        etapas: []
    };
}

function marcarInicioEtapa(metricas, nome) {
    const etapa = {
        nome,
        inicio: agoraMs(),
        fim: null,
        duracaoMs: null
    };

    metricas.etapas.push(etapa);
    console.log(`⏱️ [SEI] Iniciando etapa: ${nome}`);
    return etapa;
}

function finalizarEtapa(metricas, etapa) {
    etapa.fim = agoraMs();
    etapa.duracaoMs = etapa.fim - etapa.inicio;
    console.log(`✅ [SEI] Etapa concluída: ${etapa.nome} (${formatarDuracao(etapa.duracaoMs)})`);
}

function finalizarMetricasSei(metricas) {
    const totalMs = agoraMs() - metricas.inicioTotal;
    console.log(`🏁 [SEI] Operação "${metricas.contexto}" finalizada em ${formatarDuracao(totalMs)}.`);

    metricas.etapas.forEach(etapa => {
        console.log(`   • ${etapa.nome}: ${formatarDuracao(etapa.duracaoMs || 0)}`);
    });
}

async function executarComTimeout(promiseFactory, timeoutMs, descricao) {
    let timeoutId = null;

    const timeoutPromise = new Promise((_, reject) => {
        timeoutId = setTimeout(() => {
            reject(new Error(`Tempo limite excedido em ${descricao} (${formatarDuracao(timeoutMs)}).`));
        }, timeoutMs);
    });

    try {
        return await Promise.race([
            promiseFactory(),
            timeoutPromise
        ]);
    } finally {
        if (timeoutId) {
            clearTimeout(timeoutId);
        }
    }
}

async function esperarComTentativas(fn, {
    descricao = 'operação',
    tentativas = 20,
    intervaloMs = 500
} = {}) {
    let ultimoErro = null;

    for (let tentativa = 1; tentativa <= tentativas; tentativa++) {
        try {
            const resultado = await fn();

            if (resultado) {
                return resultado;
            }
        } catch (erro) {
            ultimoErro = erro;
        }

        if (tentativa < tentativas) {
            await esperar(intervaloMs);
        }
    }

    if (ultimoErro) {
        throw ultimoErro;
    }

    throw new Error(`Tempo esgotado ao aguardar ${descricao}.`);
}

async function aguardarFramesEstabilizarem(page, tentativas = 12) {
    let quantidadeAnterior = -1;
    let repeticoes = 0;

    for (let i = 0; i < tentativas; i++) {
        const quantidadeAtual = page.frames().length;

        if (quantidadeAtual === quantidadeAnterior) {
            repeticoes++;
            if (repeticoes >= 3) {
                return;
            }
        } else {
            repeticoes = 0;
            quantidadeAnterior = quantidadeAtual;
        }

        await esperar(TEMPO_ESPERA_CURTO);
    }
}

function logarFrames(page, titulo = 'Frames atuais') {
    try {
        console.log(`🧭 [SEI] ${titulo}:`);
        page.frames().forEach((frame, index) => {
            const nome = frame.name() || '(sem nome)';
            const url = frame.url() || '(sem url)';
            console.log(`   [${index}] nome="${nome}" | url="${url}"`);
        });
    } catch (erro) {
        console.log('⚠️ [SEI] Não consegui listar os frames atuais.');
    }
}

async function encontrarFrameDaArvore(page) {
    return await esperarComTentativas(async () => {
        const frames = page.frames();

        for (const frame of frames) {
            try {
                if (frame.name() === 'ifrArvore') {
                    return frame;
                }

                const url = String(frame.url() || '').toLowerCase();
                if (url.includes('arvore_visualizar')) {
                    return frame;
                }
            } catch (erro) {}
        }

        return null;
    }, {
        descricao: 'frame da árvore do SEI',
        tentativas: 40,
        intervaloMs: 500
    });
}

async function encontrarFrameConteudoVisualizacao(page) {
    return await esperarComTentativas(async () => {
        const frames = page.frames();

        for (const frame of frames) {
            try {
                const nome = String(frame.name() || '');
                const url = String(frame.url() || '').toLowerCase();

                if (nome === 'ifrConteudoVisualizacao' || url.includes('documento_visualizar')) {
                    return frame;
                }
            } catch (erro) {}
        }

        return null;
    }, {
        descricao: 'frame de conteúdo do documento SEI',
        tentativas: 30,
        intervaloMs: 500
    });
}

async function encontrarFrameBarraPesquisa(page) {
    return await esperarComTentativas(async () => {
        const frames = page.frames();

        for (const frame of frames) {
            try {
                const elemento = await frame.$('input[name^="txtPesquisa"]');
                if (elemento) {
                    return { frame, elemento };
                }
            } catch (erro) {}
        }

        return null;
    }, {
        descricao: 'barra de pesquisa superior do SEI',
        tentativas: 40,
        intervaloMs: 750
    });
}

async function esperarArvoreEstabilizar(frameArvore, page, {
    tentativas = 30,
    intervaloMs = 500
} = {}) {
    const seletorUniversal = 'a.infraArvoreNo, span.infraArvoreNo a, a[id^="ancora"]';

    await frameArvore.waitForSelector(seletorUniversal, { timeout: 15000 }).catch(() => {});

    let htmlSemAguardeConfirmado = 0;

    for (let i = 0; i < tentativas; i++) {
        try {
            const html = await frameArvore.content();
            const temAguarde = html.includes('Aguarde...');

            if (!temAguarde) {
                htmlSemAguardeConfirmado++;
                if (htmlSemAguardeConfirmado >= 2) {
                    return;
                }
            } else {
                htmlSemAguardeConfirmado = 0;
            }
        } catch (erro) {}

        await page.waitForLoadState('domcontentloaded').catch(() => {});
        await esperar(intervaloMs);
    }
}

async function localizarBarraPesquisa(page) {
    try {
        const resultado = await encontrarFrameBarraPesquisa(page);

        if (!resultado || !resultado.frame || !resultado.elemento) {
            logarFrames(page, 'Frames após falha ao localizar barra de pesquisa');
            throw new Error('Não foi possível localizar a barra de pesquisa superior.');
        }

        return resultado;
    } catch (erro) {
        logarFrames(page, 'Frames disponíveis no momento da falha da barra de pesquisa');
        throw erro;
    }
}

async function clicarPrimeiroVisivel(page, seletores = []) {
    for (const seletor of seletores) {
        try {
            const locator = page.locator(seletor).first();
            const count = await locator.count();

            if (count > 0 && await locator.isVisible().catch(() => false)) {
                await locator.click({ force: true }).catch(async () => {
                    try {
                        await locator.evaluate(el => el.click());
                    } catch (erro) {}
                });
                return true;
            }
        } catch (erro) {}
    }

    return false;
}

async function tentarFecharBannerPosLogin(page) {
    console.log('🧹 [SEI] Verificando se há banner/modal bloqueando a entrada...');

    const seletoresPossiveis = [
        'button:has-text("Fechar")',
        'button:has-text("FECHAR")',
        'button:has-text("Ok")',
        'button:has-text("OK")',
        'button:has-text("Confirmar")',
        'button:has-text("Continuar")',
        'button:has-text("Prosseguir")',
        'a:has-text("Fechar")',
        'a:has-text("OK")',
        'a:has-text("Ok")',
        '[aria-label="Fechar"]',
        '.modal button',
        '.dialog button',
        '.popup button',
        '.swal2-confirm',
        '.swal2-close',
        '.ui-dialog-titlebar-close'
    ];

    let algoFoiFechado = false;

    for (let tentativa = 1; tentativa <= 5; tentativa++) {
